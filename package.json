{
  "name": "second-brain-obsidian",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "dev": "node esbuild.config.mjs --watch",
    "build:test": "esbuild tests/*.test.ts --bundle --platform=node --format=esm --outdir=.test-dist",
    "test": "npm run build:test && node --test .test-dist/*.test.js"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "obsidian": "^1.7.2",
    "typescript": "^5.7.2"
  }
}
